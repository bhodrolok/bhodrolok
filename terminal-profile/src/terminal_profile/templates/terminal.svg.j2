<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 {{ width }} {{ height }}"
    width="{{ width }}"
    height="{{ height }}"
>
    <foreignObject width="100%" height="100%">
        <div xmlns="http://www.w3.org/1999/xhtml">
            <style>
                * {
                    margin: 0;
                    padding: 0;
                    box-sizing: border-box;
                }
                .terminal-window {
                    width: 100%;
                    height: 100%;
                    background: #42092b;
                    color: #e5f9e3;
                    font-family: "Source Code Pro",
                                 "Bitstream Vera Sans Mono",
                                 monospace;
                }
                .titlebar,
                .menubar {
                    background: #4a4842;
                    display: flex;
                    align-items: center;
                }
                .titlebar {
                    height: 40px;
                    justify-content: center;
                    position: relative;
                }
                .title {
                    color: #e8ead4;
                    font-size: 16px;
                }
                .window-controls {
                    position: absolute;
                    right: 12px;
                    display: flex;
                    gap: 10px;
                }
                .control {
                    color: #e8ead4;
                    font-family: sans-serif;
                }
                .menubar {
                    height: 30px;
                    padding-left: 12px;
                    gap: 18px;
                    color: #e8ead4;
                    font-family: sans-serif;
                    font-size: 13px;
                }
                hr {
                    border: 0;
                    border-top: 2px solid #3e3d39;
                }
                .terminal {
                    padding: 8px 12px;
                    font-size: {{ font_size }}px;
                    line-height: {{ line_height }}px;
                }
                .command-line {
                    white-space: nowrap;
                }
                .prompt {
                    color: #79d634;
                }
                .path {
                    color: #445caa;
                }
                .symbol {
                    color: #f5fdfe;
                }
                .command {
                    color: #e5f9e3;
                }
                .output {
                    color: antiquewhite;
                }
                .output-line {
                    white-space: pre;
                }
            </style>
            <div class="terminal-window">
                <div class="titlebar">
                    <div class="title">
                        {{ username }}@{{ hostname }}:~
                    </div>
                    <div class="window-controls">
                        <span class="control">−</span>
                        <span class="control">□</span>
                        <span class="control">×</span>
                    </div>
                </div>

                <hr />

                <div class="menubar">
                    <span>File</span>
                    <span>Edit</span>
                    <span>View</span>
                    <span>Search</span>
                    <span>Terminal</span>
                    <span>Help</span>
                </div>

                <div class="terminal">

                    {% for command in commands %}

                        <div class="command-line">
                            <span class="prompt">
                                <b>{{ username }}@{{ hostname }}:</b></span><span class="path"><b>~</b></span><span class="symbol"><b>$</b></span>
                            <span class="command"> {{ command.name }}</span>
                        </div>

                        {% for line in command.output %}
                            <div class="output output-line">{{ line }}</div>
                        {% endfor %}

                    {% endfor %}
                </div>
            </div>
        </div>
    </foreignObject>
</svg>